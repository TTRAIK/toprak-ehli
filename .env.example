# Server only. Set separately for Vercel Preview and Production. Never commit real values.
SUPABASE_URL=
# Use the project's legacy anon JWT and service_role JWT from API settings.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated Supabase Auth user UUID allowlist. Do not use an email address here.
ADMIN_USER_IDS=
# Random 32+ character server secret, generated privately and entered in Vercel.
APP_SECRET=
SITE_URL=
# demo keeps existing labeled sample portfolio; online requires all server settings above.
TOPRAK_DEPLOY_MODE=demo
# Enable the lead form only after the business approves a real disclosure and controller identity.
PRIVACY_NOTICE_TEXT=
PRIVACY_NOTICE_VERSION=
PRIVACY_CONTROLLER_NAME=
